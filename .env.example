# =============================================================
# PENNILESS AI AGENT — ENVIRONMENT TEMPLATE
# Copy this to .env and fill in your values.
# =============================================================

# ── LLM PROVIDERS (Fallback order: NVIDIA → Gemini → Groq → OpenAI → Perplexity)
NVIDIA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=medium
GROQ_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# ── AGENT IDENTITY
AGENT_NAME=my-earn-agent
AGENT_USERNAME=

# ── SUPERTEAM
SUPERTEAM_API_KEY=
SUPERTEAM_CLAIM_CODE=
SUPERTEAM_CLAIM_URL=

# ── WALLETS (receive-only PUBLIC addresses ONLY)
EVM_WALLET=0xYOUR_BASE_ADDRESS
SOL_WALLET=YOUR_SOLANA_ADDRESS_OPTIONAL

# ── GITHUB (optional)
GITHUB_TOKEN=
GITHUB_USERNAME=
